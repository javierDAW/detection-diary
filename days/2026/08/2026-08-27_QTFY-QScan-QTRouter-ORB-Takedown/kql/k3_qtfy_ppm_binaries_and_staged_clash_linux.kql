    "239b9f5677b66d3dc69e003028d041c09440330dd367763e68c0a56454afd91a",
    "dc0624c316667b89aa88afa716933235584a27d14b2a08606e43a657a95db991",
    "86881181d7244a8e9d45f5fe1e2b7f4c3e8bd6cd1e6383c92693ee956c4d87fb",
    "dbcd1588caae92b7525aac096b7ec8c543b5ab8c4c95dfb33051d42c351e19b3",
    "ad2fae2894432da7b82fec0d5d3a75b5ffa1b84a50ad67477b6063a1769a3846",
    "0d48039b416a236f6e0e0fd702b5a824e8c7118af597c81271c64bd6b0adfec2",
    "5c0708b7a7a7ca00188b40df6b80f4875b2e430b2b0c38b68dd9428bfcb98d09",
    "ba20494fe5a12955a408f076c3677bf8ae600c890554b9906049b8cd07206cfb",
    "08dc78ae82d9c480420f7cfa797334c8976077a02df5f6b4cee3072ed4a197f9",
    "ce8832b4681e63118c159f379de82f8c97adc62a81c19cae903d1ba0e5629cf1",
    "996b3aedb34426184ca4f8141daec29a0c5785b11e7eea47559f2e0ef1e6180a",
    "ab745ad10ffcbf65acdf171cd47d20aed581ac07304570d96caffacc6ece2651",
    "ef1b84fa1f3087415ba1e798b018f35c675de1032723579e38d81f79dcc37878",
    "bb1428134f6f587d63a3092ef125a7a2ac50fda3ee71b830bf725f20956b0d3f",
    "26c9b561e431d033aa16f94580bfa7ace390a1c9c6834a0ee1a6b0a9a306485c",
    "7bba7912b7fc01795b3a0503d0e546087990124a2256b083c1c5a498a205a721",
    "ea89a969d7a4e4b9c3da24577fe2d633f74c4f25fd1494905063b40b57aeca31",
    "00b0045e9e28b89946e7e839ac910f1f2e6f3c28937839aff3b0b41008c80188",
    "32876e31b1ef1b300ab4cb65ce647b110b6b801bc4e46aad3e43d406b96a6f33",
    "27eb761a029d5ee4cee1d6a1ad3b60400b91723b6927cdc0032d97d8c9e636a3",
    "12b1f2078fcdcf792e5482308acaea8cc617c58d51019edd4a381fef52329dec",
    "6547c0f20c7770bb228b9b0ac61a6d2e16e74afad37b62bcecc7e69b51354a87",
    "4a7a9354c5764a0977a004f3bf590db8c86ea747d170bf9a1541b8c7cfcf4009",
    "c7abdd66dae9f0e190361d7a39a73128e9d7dc3da338c02f3d93488786813eb3",
    "dd014653fce1fe5f19d1b0e1ad5f254118ca6d002e29c549ecb15029ed0a381e",
    "9759492bc73a1704d6d71c6f40ab5321a095f9ab2ae5ca069dd4f7b3a98235fa",
    "69a20babb22ffb372733900cb2e6739598b316aecdbc0394ce8029717ee13089",
    "5329f26cc11cba660382f58f388d2dad50e10e2ba37d0d6002622c8061b211b2",
    "6decf77b1a3595374a15a014bbb9ac9774f67dca7df59ccf4b734a68d9e35224",
    "e939954618ec089485eff4de098f6c5ce4d672acfd03150f5f0b38bbecbba664",
    "c1381b35c21aec9e74e8d42b60c4733abd23fd012c75ab0e9101e37c9be62a7a",
    "7a4c87677d7892b66c30c82ea72893bd29cfe793fade45222b4cf853b877d300",
    "d810f1253ee4bee05ca96a70a9c293f2839fb00b2aa238861f7b89e3a66bd357"
]);
let by_hash =
    union DeviceProcessEvents, DeviceFileEvents
    | where Timestamp > ago(lookback)
    | where SHA256 in (qtfy_hashes)
    | project Timestamp, DeviceId, DeviceName, Signal = "advisory_hash", FileName, FolderPath, SHA256,
              InitiatingProcessCommandLine;
let by_name =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where FolderPath has_any ("/agent_linux_", "/client_linux_", "/c_client_")
    | project Timestamp, DeviceId, DeviceName, Signal = "binary_name", FileName, FolderPath, SHA256,
              InitiatingProcessCommandLine = ProcessCommandLine;
let clash_staged =
    DeviceProcessEvents
    | where Timestamp > ago(lookback)
    | where FileName =~ "clash"
    | where FolderPath startswith "/tmp/" or FolderPath startswith "/var/tmp/" or FolderPath startswith "/dev/shm/"
    | project Timestamp, DeviceId, DeviceName, Signal = "clash_staged", FileName, FolderPath, SHA256,
              InitiatingProcessCommandLine = ProcessCommandLine;
union by_hash, by_name, clash_staged
| summarize FirstSeen = min(Timestamp), LastSeen = max(Timestamp), Events = count(),
            Signals = make_set(Signal), Paths = make_set(FolderPath, 10), Hashes = make_set(SHA256, 10)
        by DeviceId, DeviceName
| sort by FirstSeen asc
