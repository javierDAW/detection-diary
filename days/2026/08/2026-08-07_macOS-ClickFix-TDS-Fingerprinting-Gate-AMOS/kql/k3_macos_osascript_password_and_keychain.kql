// Title:       macOS ClickFix -- osascript password prompt or Keychain/credential access
// Id:          k3-clickfix-macos-osascript-keychain
// MITRE:       T1555.001, T1555.003, T1539
// Reference:   https://www.microsoft.com/en-us/security/blog/2026/08/05/macos-clickfix-campaign-learned-hide/
//              https://www.microsoft.com/en-us/security/blog/2026/05/06/clickfix-campaign-uses-fake-macos-utilities-lures-deliver-infostealers/
// Author:      Jarmi
// Date:        2026-08-07
// Tested on:   Microsoft Defender XDR advanced hunting (DeviceProcessEvents, macOS onboarded devices)
// FP notes:    osascript display-dialog password prompts and `security` are used by some
//              legitimate admin tooling; scope by parent lineage and by the ClickFix
//              curl-to-shell precursor. Add sanctioned management tools to <add_known_admin_tools>.
DeviceProcessEvents
| where Timestamp > ago(14d)
| where (FileName =~ "osascript" and ProcessCommandLine has_any ("display dialog","password","with hidden answer"))
    or (FileName =~ "security" and ProcessCommandLine has_any ("find-generic-password","find-internet-password","dump-keychain"))
    or ProcessCommandLine has "login.keychain-db"
| where InitiatingProcessCommandLine !has_any (dynamic(["<add_known_admin_tools>"]))
| project Timestamp, DeviceName, AccountName, InitiatingProcessFileName, FileName, ProcessCommandLine
| sort by Timestamp desc
