// Title: Storm-1175 Post-N-central Persistence - svchost in Documents and Cloudflared
// Id: a930b70a-8bf3-4455-8c96-86dc1043cf2a
// MITRE: T1036.005, T1572, T1543.003
// Reference: https://status.n-able.com/2026/08/02/n-central-2026-3-hotfix-1-mitigation-for-cve-2026-18577/
// Author: Jarmi
// Date: 2026-08-11
// Tested on: Microsoft Defender XDR (DeviceProcessEvents, DeviceFileEvents)
// FP notes: Cloudflared can be legitimate; svchost.exe from a Documents folder is not.
let svchost_doc = DeviceProcessEvents
    | where FileName =~ "svchost.exe" and FolderPath has @"\Documents\"
    | project Timestamp, DeviceName, DeviceId, Signal = "svchost_in_documents", FileName, FolderPath, InitiatingProcessFileName, AccountName, ReportId;
let cloudflared = DeviceProcessEvents
    | where FileName =~ "cloudflared.exe"
        and (ProcessCommandLine has "tunnel run" or ProcessCommandLine has "--token" or ProcessCommandLine has "trycloudflare")
    | project Timestamp, DeviceName, DeviceId, Signal = "cloudflared_tunnel", FileName, FolderPath, InitiatingProcessFileName, AccountName, ReportId;
union svchost_doc, cloudflared
| sort by Timestamp desc
