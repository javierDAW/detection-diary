// Title: agent-framework 1.26.1 / 1.26.2 startup-hook files in site-packages by name and by published SHA-256
// Id: 5b0f2a6e-3c1d-4e8a-9f27-6d4b1c8e7a10
// MITRE: T1195.001 (Compromise Software Dependencies and Development Tools), T1546.018 (Python Startup Hooks), T1059.006 (Python)
// Reference: https://github.com/microsoft/agent-framework/issues/10411
// Author: Jarmi
// Date: 2026-11-19
// Tested on: Microsoft Defender XDR advanced hunting (DeviceFileEvents); not tested against live data
// FP notes: File names are campaign-specific. Hashes cover only the 1.26.2 wheel, af_runtime_diag.py and af_runtime_diag.pth (published by GBHackers); no hashes were published for 1.26.1 files, so 1.26.1 is matched by name only.
let windowStart = datetime(2026-11-17 20:30:00);
let badHashes = dynamic([
    "3d20a8bc91351a9a16b6db243b848ceca0206b7a8623b02d2af553a9c9f7e0a9",
    "54d885b7d7161c9ed96489c66364c4bfbf635929166843bba10d97d46b5a2e1f",
    "325e7e9f0ec94e41ad1a1b7a3f18a6b8b5bffece2e2b97b8d3369eb967452f93"]);
DeviceFileEvents
| where Timestamp >= windowStart
| where SHA256 in~ (badHashes)
    or (FolderPath has "site-packages" and FileName in~ ("agent_framework_meta.pth", "af_runtime_diag.pth", "af_runtime_diag.py"))
    or FileName startswith "agent_framework-1.26.1" or FileName startswith "agent_framework-1.26.2"
| project Timestamp, DeviceName, ActionType, FolderPath, FileName, SHA256, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName
| order by Timestamp asc
