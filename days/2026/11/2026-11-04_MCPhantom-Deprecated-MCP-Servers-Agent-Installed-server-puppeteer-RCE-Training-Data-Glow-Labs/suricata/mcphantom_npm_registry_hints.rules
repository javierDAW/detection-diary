# MCPhantom - npm registry access inventory hints (Suricata 7.x)
# Author: Jarmi
# Date: 2026-11-04
# Reference: https://www.glow.io/blogs/mcphantom-ai-coding-agents-are-installing-vulnerable-deprecated-mcp-servers-from-training-data
# Reference: https://www.helpnetsecurity.com/2026/11/03/mcphantom-deprecated-mcp-servers/
#
# Context: Glow Labs found AI coding agents installing archived, deprecated @modelcontextprotocol
# MCP servers via npx. npm registry traffic is TLS-encrypted, so the package name, version and
# deprecation status are NOT visible on the wire. These rules do NOT detect the server-puppeteer
# exploit or a deprecated package install; they only inventory which developer hosts fetch from
# the public npm registry so you can correlate with endpoint telemetry (Sigma/KQL in this folder).
# Confidence: low, no technical IOC published. The registry hostname is generic npm knowledge.
#
# Custom variables:
#   $DEV_NETS - developer workstation / CI subnets; set in your suricata.yaml address-groups,
#               e.g. DEV_NETS: "[10.20.0.0/16]"
#
# threshold limits each source to one alert per hour to keep this an inventory signal.

alert tls $DEV_NETS any -> $EXTERNAL_NET any (msg:"JARMI MCPhantom hint - developer host TLS session to public npm registry (inventory)"; flow:established,to_server; tls.sni; content:"registry.npmjs.org"; endswith; nocase; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:created_at 2026_11_04, confidence low, author Jarmi; sid:9920001; rev:1;)

alert dns $DEV_NETS any -> any any (msg:"JARMI MCPhantom hint - developer host DNS query for public npm registry (inventory)"; dns.query; content:"registry.npmjs.org"; endswith; nocase; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:created_at 2026_11_04, confidence low, author Jarmi; sid:9920002; rev:1;)

alert tls !$DEV_NETS any -> $EXTERNAL_NET any (msg:"JARMI MCPhantom hint - non-developer host TLS session to public npm registry (unexpected npx use, review)"; flow:established,to_server; tls.sni; content:"registry.npmjs.org"; endswith; nocase; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:created_at 2026_11_04, confidence low, author Jarmi; sid:9920003; rev:1;)
