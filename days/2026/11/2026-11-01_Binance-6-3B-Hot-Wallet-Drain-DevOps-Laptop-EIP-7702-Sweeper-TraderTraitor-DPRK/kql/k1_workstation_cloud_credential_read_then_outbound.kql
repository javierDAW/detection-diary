// Title: Developer workstation - cloud CLI / kubeconfig credential access by an interpreter, followed within 10 minutes by outbound traffic from the same process tree
// Id: 2b6f0c1e-5a7d-4e3b-9c41-7d2e8f1a6b30
// MITRE: T1552.001 (Credentials In Files), T1528 (Steal Application Access Token), T1041 (Exfiltration Over C2 Channel)
// Reference: https://www.forbes.com/sites/digital-assets/2026/10/30/binances-63-billion-hack-started-with-one-engineers-laptop/ ; https://hackread.com/binance-devops-engineer-hacked-laptop-billion-theft/
// Author: Jarmi
// Date: 2026-11-01
// Tested on: Microsoft Defender XDR advanced hunting syntax; not run against a live tenant. Needs Defender for Endpoint on the developer fleet (Windows, macOS or Linux).
// Scope: no IOC, malware name, tool name or credential type was published for the Binance hot-wallet drain (2026-10-29/30). This query does NOT
//        detect that attack; it is a behaviour lead (confidence low) for the published first finding: a compromised DevOps laptop.
// FP notes: IDE plugins, kubectl wrappers and SDK token refresh read these files constantly. The join on the same initiating process id plus
//           a non-allowlisted remote host is what narrows it. Fill <add_known_dev_tool_processes> and <add_known_cloud_api_domains>.
let Lookback = 7d;
let CredMarkers = dynamic([".aws/credentials", ".aws\\credentials", ".kube/config", ".kube\\config", "gcloud/credentials.db", "gcloud\\credentials.db",
                           "sts get-session-token", "configure export-credentials", "secretsmanager get-secret-value", "print-access-token",
                           "get secret", "config view --raw"]);
let Interpreters = dynamic(["node", "node.exe", "python", "python3", "python.exe", "ruby", "perl", "pwsh", "pwsh.exe", "powershell.exe", "bash", "sh", "osascript"]);
let KnownDevTools = dynamic(["<add_known_dev_tool_processes>"]);
let KnownCloudApi = dynamic(["<add_known_cloud_api_domains>"]);
let CredAccess =
    DeviceProcessEvents
    | where Timestamp > ago(Lookback)
    | where ProcessCommandLine has_any (CredMarkers)
    | where InitiatingProcessFileName in~ (Interpreters)
    | where not(InitiatingProcessFileName in~ (KnownDevTools))
    | project CredTime = Timestamp, DeviceId, DeviceName, AccountName, CredProcess = FileName, CredCommandLine = ProcessCommandLine,
              ParentPid = InitiatingProcessId, ParentName = InitiatingProcessFileName, ParentCommandLine = InitiatingProcessCommandLine,
              ParentFolder = InitiatingProcessFolderPath;
let Egress =
    DeviceNetworkEvents
    | where Timestamp > ago(Lookback)
    | where RemoteIPType == "Public"
    | where not(RemoteUrl has_any (KnownCloudApi))
    | project NetTime = Timestamp, DeviceId, ParentPid = InitiatingProcessId, ParentName = InitiatingProcessFileName, RemoteIP, RemotePort, RemoteUrl;
CredAccess
| join kind=inner Egress on DeviceId, ParentPid, ParentName
| where NetTime between (CredTime .. CredTime + 10m)
| summarize FirstCred = min(CredTime), Destinations = make_set(strcat(RemoteUrl, " ", RemoteIP, ":", tostring(RemotePort)), 20),
            CredCommands = make_set(CredCommandLine, 10) by DeviceName, AccountName, ParentName, ParentCommandLine, ParentFolder
| sort by FirstCred desc
