// Title: Agentic AI secret abuse - Entra service principal sign-ins from published IPs, one IP hitting 3+ service principals with mixed results, and AADSTS7000215/7000222 failure followed by success (Sentinel)
// Id: ab8ca0a3-b222-4d3b-88db-231955c8b8af
// MITRE: T1078.004 Valid Accounts: Cloud Accounts; T1552.001 Unsecured Credentials: Credentials In Files (secrets leaked on GitHub); T1110 Brute Force (credential validation pattern) (mapping by Jarmi, not published by the vendor)
// Reference: Microsoft Threat Intelligence 2026-11-05 "Threat actors use agentic AI tooling to find and abuse exposed secrets" https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/
// Author: Jarmi
// Date: 2026-11-11
// Tested on: not tested
// Honesty: the IPs are published by Microsoft (199.19.77.84 and 199.19.77.18 main sources from 2026-10-28; 199.19.77.18 is a Tor exit; 65.87.223.26 and 157.22.126.128 "may be linked"); they may be rotated or reassigned. The three heuristics (failure-then-success, one IP many service principals, 7000215/7000222) follow Microsoft guidance; the thresholds and windows are my own. Microsoft's own Advanced Hunting query text was not available and is NOT reproduced here. No user agents are published, so none are matched.
// Tables: AADServicePrincipalSignInLogs (Sentinel, Entra diagnostic category ServicePrincipalSignInLogs). Defender XDR equivalent: EntraIdSpnSignInEvents (column names differ - verify in your tenant). Verify ResultType is a string in your workspace.
// Confidence: high for the published IPs (at the time of publication); medium for failure-then-success; low-medium for one IP / many service principals.
// FP notes: CI/CD runners and shared egress NAT authenticating many apps (baseline in <add_known_ips>); pipelines still using a rotated secret (7000215/7000222 from your own ranges).
let Lookback = 14d;
let CampaignIps = dynamic(["199.19.77.84", "199.19.77.18", "65.87.223.26", "157.22.126.128"]);
let KnownIps = dynamic(["<add_known_ips>"]);
let SecretFailCodes = dynamic(["7000215", "7000222"]);
let Spn = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(Lookback)
    | extend ResultType = tostring(ResultType)
    | where IPAddress !in (KnownIps)
    | project TimeGenerated, IPAddress, AppId, ServicePrincipalName, ServicePrincipalId, ResourceDisplayName, ResultType, ResultDescription, Location, TenantId;
// 1) Any service principal sign-in (success or failure) from the published IPs
let FromCampaignIps = Spn
    | where IPAddress in (CampaignIps)
    | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Apps = make_set(ServicePrincipalName, 50), Resources = make_set(ResourceDisplayName, 20), Results = make_set(ResultType, 10), Attempts = count() by IPAddress
    | extend Signal = "PublishedCampaignIP", Severity = iff(Results has "0", "high", "medium");
// 2) One IP authenticating to 3+ distinct service principals within 1h with mixed success and failure
let MultiSpn = Spn
    | summarize DistinctSpn = dcount(AppId), Successes = countif(ResultType == "0"), Failures = countif(ResultType != "0"), Apps = make_set(ServicePrincipalName, 50), Resources = make_set(ResourceDisplayName, 20), Results = make_set(ResultType, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Attempts = count() by IPAddress, bin(TimeGenerated, 1h)
    | where DistinctSpn >= 3 and Successes > 0 and Failures > 0
    | project FirstSeen, LastSeen, IPAddress, Apps, Resources, Results, Attempts
    | extend Signal = "OneIpManyServicePrincipals", Severity = "medium";
// 3) Invalid / expired client secret failure followed by success for the same app from the same IP within 24h
let SecretFails = Spn
    | where ResultType in (SecretFailCodes)
    | project FailTime = TimeGenerated, IPAddress, AppId, ServicePrincipalName, FailCode = ResultType;
let Successes = Spn
    | where ResultType == "0"
    | project SuccessTime = TimeGenerated, IPAddress, AppId, ResourceDisplayName;
let FailThenSuccess = SecretFails
    | join kind=inner (Successes) on IPAddress, AppId
    | where SuccessTime between (FailTime .. (FailTime + 24h))
    | summarize FirstSeen = min(FailTime), LastSeen = max(SuccessTime), Apps = make_set(ServicePrincipalName, 50), Resources = make_set(ResourceDisplayName, 20), Results = make_set(FailCode, 10), Attempts = count() by IPAddress
    | extend Signal = "SecretFailureThenSuccess", Severity = "high";
union FromCampaignIps, MultiSpn, FailThenSuccess
| extend IsTorExit = IPAddress == "199.19.77.18"
| order by Severity asc, FirstSeen desc
