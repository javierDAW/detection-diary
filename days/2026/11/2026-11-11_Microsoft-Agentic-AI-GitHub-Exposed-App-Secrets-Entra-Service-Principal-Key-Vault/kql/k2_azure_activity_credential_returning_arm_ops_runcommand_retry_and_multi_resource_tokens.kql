// Title: Agentic AI secret abuse - credential-returning ARM operations and VM Run Command by service principals, ARM 400-then-200 retry fingerprint, and one app requesting ARM + Key Vault + Storage + Graph tokens within 1h (Sentinel)
// Id: a8174dde-4a40-4eb0-b511-e54dab397b51
// MITRE: T1552 Unsecured Credentials; T1555.006 Cloud Secrets Management Stores; T1651 Cloud Administration Command; T1580 Cloud Infrastructure Discovery; T1526 Cloud Service Discovery (mapping by Jarmi, not published by the vendor)
// Reference: Microsoft Threat Intelligence 2026-11-05 https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/
// Author: Jarmi
// Date: 2026-11-11
// Tested on: not tested
// Honesty: Microsoft reports ARM calls returning storage account keys, App Service settings, connection strings, publishing credentials, AI/ML connections and datastores and AKS user credentials, VM Run Command via a compromised OAuth app, and ARM calls from 199.19.77.84 that returned HTTP 400 (wrong api-version) and were resent 28-80 seconds later with a corrected api-version (for example 2023-07-01) returning 200. The operation list below is generic Azure knowledge, not request shapes published by Microsoft.
// Limits of the retry fingerprint: AzureActivity does NOT log the api-version and does not log plain GET reads (Microsoft's examples include GETs such as SQL firewall rules and Key Vault secret metadata). This query approximates it as "same caller + same operation + same resource: Failed then Succeeded within 120s". For the exact fingerprint (HTTP status + api-version) use Defender for Cloud Apps / CloudAuditEvents raw data or ARM request telemetry if your tenant exposes it - verify columns in your tenant.
// Tables: AzureActivity, AADServicePrincipalSignInLogs (Sentinel). Defender XDR equivalents: CloudAuditEvents, EntraIdSpnSignInEvents (verify column names in your tenant).
// Confidence: medium for credential listing / Run Command by a non-baselined service principal; low-medium for the retry fingerprint; medium for multi-resource tokens.
// FP notes: backup, DevOps and IaC pipelines legitimately call listKeys / publishxml (baseline their AppIds in <add_known_automation_appids>); Azure Portal-driven listKeys appear with a user caller, not an SPN.
let Lookback = 14d;
let CampaignIps = dynamic(["199.19.77.84", "199.19.77.18", "65.87.223.26", "157.22.126.128"]);
let KnownAutomation = dynamic(["<add_known_automation_appids>"]);
let CredOps = dynamic(["/LISTKEYS/ACTION", "/LISTCREDENTIALS/ACTION", "/LISTCLUSTERUSERCREDENTIAL/ACTION", "/LISTCLUSTERADMINCREDENTIAL/ACTION", "/PUBLISHXML/ACTION", "/CONFIG/LIST/ACTION", "/LISTSECRETS/ACTION", "/LISTCONNECTIONSTRINGS/ACTION", "/LISTPUBLISHINGCREDENTIALS/ACTION", "/RUNCOMMAND/ACTION"]);
let Act = AzureActivity
    | where TimeGenerated > ago(Lookback)
    | extend Op = toupper(OperationNameValue)
    | extend Claims = parse_json(Claims)
    | extend CallerAppId = tostring(Claims.appid), IdType = tostring(Claims.idtyp)
    | extend IsSpn = IdType == "app" or Caller matches regex @"^[0-9a-fA-F-]{36}$";
// 1) Credential-returning ARM operations or VM Run Command by a service principal outside the automation baseline (or from the published IPs)
let CredHarvest = Act
    | where Op has_any (CredOps)
    | where (IsSpn and CallerAppId !in (KnownAutomation)) or CallerIpAddress in (CampaignIps)
    | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Ops = make_set(OperationNameValue, 30), Resources = make_set(_ResourceId, 50), Subscriptions = make_set(SubscriptionId, 10), Ips = make_set(CallerIpAddress, 10), Count = count() by Caller, CallerAppId
    | extend Signal = "CredentialReturningArmOps", Severity = iff(Ips has_any (CampaignIps) or array_length(Ops) >= 3 or Ops has "RUNCOMMAND", "high", "medium");
// 2) Retry fingerprint approximation: same caller + operation + resource, Failed then Succeeded within 120s
let Retry = Act
    | where IsSpn or CallerIpAddress in (CampaignIps)
    | where ActivityStatusValue in ("Failure", "Failed", "Success", "Succeeded")
    | extend Ok = ActivityStatusValue in ("Success", "Succeeded")
    | project TimeGenerated, Caller, CallerAppId, CallerIpAddress, OperationNameValue, _ResourceId, Ok, StatusCode = tostring(parse_json(Properties).statusCode)
    | order by Caller asc, OperationNameValue asc, _ResourceId asc, TimeGenerated asc
    | serialize
    | extend PrevOk = prev(Ok), PrevTime = prev(TimeGenerated), PrevKey = prev(strcat(Caller, "|", OperationNameValue, "|", _ResourceId)), PrevStatus = prev(StatusCode)
    | where strcat(Caller, "|", OperationNameValue, "|", _ResourceId) == PrevKey and PrevOk == false and Ok == true
    | extend GapSec = datetime_diff("second", TimeGenerated, PrevTime)
    | where GapSec between (1 .. 120)
    | summarize FirstSeen = min(PrevTime), LastSeen = max(TimeGenerated), Ops = make_set(OperationNameValue, 30), Resources = make_set(_ResourceId, 50), Ips = make_set(CallerIpAddress, 10), Gaps = make_set(GapSec, 20), PrevStatuses = make_set(PrevStatus, 10), Count = count() by Caller, CallerAppId
    | extend Signal = "FailThenSucceedRetryWithin120s", Severity = iff(Count >= 3, "medium", "low");
// 3) One service principal acquiring tokens for ARM + Key Vault + Storage + Graph within 1h
let MultiResource = AADServicePrincipalSignInLogs
    | where TimeGenerated > ago(Lookback)
    | where tostring(ResultType) == "0"
    | extend Res = case(ResourceDisplayName has "Azure Resource Manager" or ResourceDisplayName has "Windows Azure Service Management API", "ARM",
                        ResourceDisplayName has "Key Vault", "KeyVault",
                        ResourceDisplayName has "Azure Storage", "Storage",
                        ResourceDisplayName has "Microsoft Graph", "Graph", "Other")
    | where Res != "Other"
    | where AppId !in (KnownAutomation)
    | summarize ResSet = make_set(Res), Ips = make_set(IPAddress, 10), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Count = count() by AppId, ServicePrincipalName, bin(TimeGenerated, 1h)
    | where array_length(ResSet) >= 4
    | project FirstSeen, LastSeen, Caller = ServicePrincipalName, CallerAppId = AppId, Ops = ResSet, Ips, Count
    | extend Signal = "TokensForArmKeyVaultStorageGraphWithin1h", Severity = iff(Ips has_any (CampaignIps), "high", "medium");
union CredHarvest, Retry, MultiResource
| order by Severity asc, FirstSeen desc
