// Title: Agentic AI secret abuse - Key Vault SecretList / SecretGet bursts by service principals from non-baselined IPs, and storage data-plane access from the published campaign IPs (Sentinel)
// Id: 1ab9f1ed-f83e-405f-8851-da2c9fc30382
// MITRE: T1555.006 Cloud Secrets Management Stores; T1530 Data from Cloud Storage; T1078.004 Valid Accounts: Cloud Accounts (mapping by Jarmi, not published by the vendor)
// Reference: Microsoft Threat Intelligence 2026-11-05 https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/
// Author: Jarmi
// Date: 2026-11-11
// Tested on: not tested
// Honesty: Microsoft reports Key Vault secret metadata enumeration and exfiltration of Key Vault secrets (GitHub secret search to Key Vault exfiltration took five minutes in one case) and storage account key harvesting. Exact requests, user agents and volumes are NOT published; the burst threshold below is my own. Azure DevOps and GitHub-side secret searches are not visible in these tables and are out of scope here (see hunts/peak_h3).
// Tables: AzureDiagnostics (Key Vault AuditEvent, legacy Azure Diagnostics mode) or AZKVAuditLogs (resource-specific mode); StorageBlobLogs (Storage diagnostic settings). Defender XDR equivalent for storage: CloudStorageAggregatedEvents (verify columns in your tenant). Column names below are for AzureDiagnostics legacy mode - verify in your tenant.
// Confidence: high for any storage / Key Vault access from the published IPs (at the time of publication); medium for SecretList+SecretGet bursts by a non-baselined service principal from a new IP.
// FP notes: applications reading their own secrets at start-up (stable IP, few secrets); backup or secret-sync tooling (baseline in <add_known_ips> / <add_known_automation_appids>).
let Lookback = 14d;
let Baseline = 30d;
let CampaignIps = dynamic(["199.19.77.84", "199.19.77.18", "65.87.223.26", "157.22.126.128"]);
let KnownIps = dynamic(["<add_known_ips>"]);
let KnownAutomation = dynamic(["<add_known_automation_appids>"]);
let Kv = AzureDiagnostics
    | where TimeGenerated > ago(Lookback + Baseline)
    | where ResourceProvider == "MICROSOFT.KEYVAULT" and Category == "AuditEvent"
    | where OperationName in ("SecretList", "SecretGet", "SecretListVersions", "KeyList", "CertificateList", "CertificateGet")
    | extend AppId = tostring(column_ifexists("identity_claim_appid_g", "")), Oid = tostring(column_ifexists("identity_claim_http_schemas_microsoft_com_identity_claims_objectidentifier_g", ""))
    | project TimeGenerated, Resource, OperationName, CallerIPAddress, AppId, Oid, ResultSignature, id_s = tostring(column_ifexists("id_s", ""));
let KvBaseline = Kv
    | where TimeGenerated between (ago(Lookback + Baseline) .. ago(Lookback))
    | distinct AppId, CallerIPAddress;
// 1) SecretList + SecretGet burst by an app from an IP never seen for that app in the baseline window
let KvBurst = Kv
    | where TimeGenerated > ago(Lookback)
    | where CallerIPAddress !in (KnownIps) and AppId !in (KnownAutomation)
    | join kind=leftanti (KvBaseline) on AppId, CallerIPAddress
    | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Lists = countif(OperationName endswith "List" or OperationName endswith "ListVersions"), Gets = countif(OperationName endswith "Get"), Vaults = make_set(Resource, 20), Items = make_set(id_s, 50), Results = make_set(ResultSignature, 10) by AppId, CallerIPAddress, bin(TimeGenerated, 1h)
    | where Lists >= 1 and Gets >= 5
    | project FirstSeen, LastSeen, Identity = AppId, IPAddress = CallerIPAddress, Detail = Vaults, Items, Results, Count = Lists + Gets
    | extend Signal = "KeyVaultSecretBurstNewIp", Severity = iff(IPAddress in (CampaignIps), "high", "medium");
// 2) Any Key Vault access from the published IPs
let KvCampaign = Kv
    | where TimeGenerated > ago(Lookback)
    | where CallerIPAddress in (CampaignIps)
    | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Detail = make_set(Resource, 20), Items = make_set(id_s, 50), Results = make_set(ResultSignature, 10), Count = count() by Identity = AppId, IPAddress = CallerIPAddress
    | extend Signal = "KeyVaultFromCampaignIP", Severity = "high";
// 3) Storage data-plane access from the published IPs (needs blob diagnostic settings; the IP column may carry a port suffix)
let StorageCampaign = StorageBlobLogs
    | where TimeGenerated > ago(Lookback)
    | extend IPAddress = tostring(split(CallerIpAddress, ":")[0])
    | where IPAddress in (CampaignIps)
    | summarize FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated), Detail = make_set(AccountName, 20), Items = make_set(Uri, 50), Results = make_set(StatusText, 10), Count = count(), Bytes = sum(ResponseBodySize) by Identity = AuthenticationType, IPAddress
    | extend Signal = "StorageFromCampaignIP", Severity = "high";
union KvBurst, KvCampaign, StorageCampaign
| extend IsTorExit = IPAddress == "199.19.77.18"
| order by Severity asc, FirstSeen desc
