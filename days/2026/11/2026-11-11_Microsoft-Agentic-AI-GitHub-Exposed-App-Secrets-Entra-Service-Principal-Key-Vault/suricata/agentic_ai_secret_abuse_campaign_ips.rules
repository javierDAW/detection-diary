# Agentic AI secret abuse (Microsoft Threat Intelligence, 2026-11-05) - published IPs and a generic user-agent heuristic (Suricata 7.x)
# Author: Jarmi
# Date: 2026-11-11
# Reference: Microsoft Threat Intelligence 2026-11-05
#            https://www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/
#
# Honesty: most of this activity is cloud-API traffic from the actor to Microsoft Entra ID, Azure
# Resource Manager, Key Vault, Storage and Graph - it never crosses your network sensor, so these rules
# are marginal. They help only if you host internet-facing workloads behind a Suricata sensor (for
# example App Service-like or AI inference endpoints on your own infrastructure) or to spot internal
# hosts talking to the same addresses. The IPs are published by Microsoft but may be rotated or
# reassigned; 199.19.77.18 is a Tor exit node and will also match unrelated Tor traffic;
# 65.87.223.26 and 157.22.126.128 "may be linked" per Microsoft (not confirmed). Microsoft reports
# shell commands embedded in the user agent from 65.87.223.26 but did NOT publish the strings; rule
# 9990003 is a generic, low-confidence heuristic for command substitution / pipe-to-shell patterns in
# the User-Agent header, not a campaign signature. No domains, URIs, JA3/JA4 or certificates published.
#
# 9990001 - any IP traffic from $HOME_NET to 199.19.77.84 / 199.19.77.18 (main sign-in sources)
# 9990002 - inbound HTTP from 65.87.223.26 / 157.22.126.128 (possibly linked) to $HOME_NET
# 9990003 - inbound HTTP whose User-Agent carries $( , a backtick, ;curl , ;wget or |sh / |bash (generic)
#
# Variables (define in suricata.yaml):
#   $HOME_NET      - standard internal networks (include published web / API front ends)
#   $EXTERNAL_NET  - standard external networks
# Not compile-tested (no engine available at authoring time).

alert ip $HOME_NET any -> [199.19.77.84,199.19.77.18] any (msg:"Agentic AI secret abuse - traffic to IP published by Microsoft as Entra service principal sign-in source (199.19.77.18 is a Tor exit)"; threshold:type limit, track by_src, count 1, seconds 3600; reference:url,www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/; classtype:misc-activity; sid:9990001; rev:1; metadata:author Jarmi, created_at 2026_11_11, confidence medium;)

alert http [65.87.223.26,157.22.126.128] any -> $HOME_NET any (msg:"Agentic AI secret abuse - inbound HTTP from IP Microsoft reports as possibly linked (exploitation / Azure AI recon)"; flow:established,to_server; threshold:type limit, track by_src, count 1, seconds 3600; reference:url,www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/; classtype:attempted-recon; sid:9990002; rev:1; metadata:author Jarmi, created_at 2026_11_11, confidence low;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Generic heuristic - shell command substitution or pipe-to-shell in HTTP User-Agent (pattern class reported by Microsoft for agentic AI tooling, strings not published)"; flow:established,to_server; http.user_agent; pcre:"/(?:\$\(|`|;\s*(?:curl|wget)\b|\|\s*(?:ba)?sh\b)/i"; reference:url,www.microsoft.com/en-us/security/blog/2026/11/05/threat-actors-use-agentic-ai-tooling-to-find-and-abuse-exposed-secrets/; classtype:web-application-attack; sid:9990003; rev:1; metadata:author Jarmi, created_at 2026_11_11, confidence low;)
