# Title: MacSync - distribution and C2 domains, backdoor URL paths (network detections)
# Author: Jarmi
# Date: 2026-09-24
# Reference: https://securelist.com/macsync-new-version/121383/
# Variables: $HOME_NET = internal ranges, $EXTERNAL_NET = everything else.
# Visibility: every published URL is https, so the HTTP rules only fire on decrypted traffic or on cleartext fallbacks. The DNS and SNI rules work on encrypted taps.
# Caution: caldav.icloud.com and gateway.icloud.com are legitimate Apple services and are NOT matched here by name alone. Detect the requesting process with the Sigma and KQL files.
# Domains are rotated by the operator; treat the DNS and SNI rules as known-infrastructure detections with a short shelf life.
alert dns $HOME_NET any -> any any (msg:"JARMI MacSync DNS query for apple03cloudstore.com (C2 and installer host)"; dns.query; dotprefix; content:".apple03cloudstore.com"; nocase; endswith; classtype:trojan-activity; sid:6310001; rev:1; metadata:created_at 2026_09_24, confidence high;)
alert dns $HOME_NET any -> any any (msg:"JARMI MacSync DNS query for appstore.com.mx look-alike host (C2 and installer host)"; dns.query; pcre:"/^(?:docsend|streamyard|waaako)\.appstore\.com\.mx$/i"; classtype:trojan-activity; sid:6310002; rev:1; metadata:created_at 2026_09_24, confidence high;)
alert dns $HOME_NET any -> any any (msg:"JARMI MacSync DNS query for toria.app or warpcast.asia (fake Toria wallet lure)"; dns.query; pcre:"/(?:^|\.)(?:toria\.app|warpcast\.asia)$/i"; classtype:trojan-activity; sid:6310003; rev:1; metadata:created_at 2026_09_24, confidence medium;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI MacSync TLS SNI apple03cloudstore.com (C2 and installer host)"; tls.sni; dotprefix; content:".apple03cloudstore.com"; nocase; endswith; classtype:trojan-activity; sid:6310004; rev:1; metadata:created_at 2026_09_24, confidence high;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI MacSync TLS SNI appstore.com.mx look-alike host (C2 and installer host)"; tls.sni; pcre:"/^(?:docsend|streamyard|waaako)\.appstore\.com\.mx$/i"; classtype:trojan-activity; sid:6310005; rev:1; metadata:created_at 2026_09_24, confidence high;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI MacSync TLS SNI toria.app or warpcast.asia (fake Toria wallet lure)"; tls.sni; pcre:"/(?:^|\.)(?:toria\.app|warpcast\.asia)$/i"; classtype:trojan-activity; sid:6310006; rev:1; metadata:created_at 2026_09_24, confidence medium;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI MacSync backdoor tasking request GET /v1/agent/ping with tag and build parameters"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"/v1/agent/ping"; startswith; content:"tag="; content:"build="; classtype:trojan-activity; sid:6310007; rev:1; metadata:created_at 2026_09_24, confidence medium;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI MacSync backdoor upload to /v1/asset/ with X-Upload-Token header"; flow:to_server,established; http.uri; content:"/v1/asset/"; startswith; http.header; content:"X-Upload-Token|3a|"; nocase; classtype:trojan-activity; sid:6310008; rev:1; metadata:created_at 2026_09_24, confidence medium;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI Cleartext request for a published iCloud calendar from an internal host (hunting)"; flow:to_server,established; http.host; content:"caldav.icloud.com"; http.uri; content:"/published/"; startswith; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; sid:6310009; rev:1; metadata:created_at 2026_09_24, confidence low;)
