// Title: Token replay sign-ins: 1337 Services addresses, scripted user agents and Office or Broker client IDs
// Id: ec97b474-1956-44d8-b271-ad3cc874c85b
// MITRE: T1078.004 (Valid Accounts: Cloud Accounts), T1550.001 (Application Access Token), T1528 (Steal Application Access Token)
// Reference: https://www.huntress.com/blog/token-replay-spray
// Author: Jarmi
// Date: 2026-10-28
// Tested on: Microsoft Sentinel (SigninLogs, AADNonInteractiveUserSignInLogs); not run against a tenant that received this campaign
// FP notes: Hosting addresses are reassigned and researchers test published indicators. A bare user agent from a corporate script is the main benign case. AADSTS53003 means a valid credential was blocked by Conditional Access, so keep those rows: they show exposure, not failure.
let lookback = 90d;
let replayIps = dynamic(["124.198.132.33", "45.83.31.44", "192.159.99.172", "185.238.2.195", "167.148.41.96"]);
let officeApps = dynamic(["d3590ed6-52b3-4102-aeff-aad2292ab01c", "29d9ed98-a469-4536-ade2-f981bc1d605e", "4765445b-32c6-49b0-83e6-1d93765276ca"]);
let allSignins = union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
    | where TimeGenerated > ago(lookback)
    | extend InBlock = ipv4_is_in_range(IPAddress, "193.26.115.0/24")
    | extend Signal = case(
        InBlock or IPAddress in (replayIps), "published-replay-host",
        AppId in (officeApps) and UserAgent in~ ("node", "Mozilla/5.0"), "scripted-user-agent-office-app",
        ResultType == "53003" and AppId in (officeApps), "valid-credential-blocked-by-CA",
        "")
    | where Signal != "";
allSignins
| summarize First = min(TimeGenerated), Last = max(TimeGenerated), Attempts = count(), Successes = countif(ResultType == "0"), Apps = make_set(AppDisplayName, 5), UAs = make_set(UserAgent, 5) by UserPrincipalName, IPAddress, Signal
| order by Successes desc, First asc
