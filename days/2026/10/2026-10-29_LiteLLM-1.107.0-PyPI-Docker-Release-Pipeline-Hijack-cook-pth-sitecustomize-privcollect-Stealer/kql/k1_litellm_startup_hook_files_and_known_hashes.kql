// Title: LiteLLM 1.107.0 startup-hook files (cook.pth, cook.py, sitecustomize.py) by name in site-packages and by SHA-256
// Id: a1a4e85b-8d35-4cab-90d7-6376c025ca2d
// MITRE: T1195.001 (Compromise Software Dependencies and Development Tools), T1546.018 (Python Startup Hooks), T1059.006 (Python)
// Reference: https://www.microsoft.com/en-us/security/blog/2026/10/23/inside-the-litellm-1-107-0-supply-chain-compromise-credential-theft-through-python-startup-hooks/
// Author: Jarmi
// Date: 2026-10-29
// Tested on: Microsoft Defender XDR advanced hunting (DeviceFileEvents); not run against an environment that installed the poisoned release
// FP notes: sitecustomize.py is legitimate in some Python images, so match it by hash or alongside cook.pth, not by name alone. Hash list is the six startup-file SHA-256 values published for 1.107.0 (Windows and POSIX variants).
let badHashes = dynamic([
    "84dc8c82c0a4a4a62552ef826b49fcc86d1a5c4a5d0f2c06665723f93d129d7d",
    "7f191632e7320705d154b85204f1ae546b543acbd7e8861229b76f5042b92bdb",
    "03ac2a8b752605d1d7710979c17ff18b03dd978203ba23ba97fd8ce3d6f897ea",
    "9dd0a3926f96a37eb86cf1ee2310d9be93139cc4ebef3ef9e2efe9531390be25",
    "b6122440d0d9cb1eb1ade9933f49214da8c31288de7710c076c2680dfa528465",
    "34bef04fe88ac9d0aae0475630b1738681d15b94f233ac8aa46eacf5968305fa"]);
DeviceFileEvents
| where Timestamp > ago(30d)
| where SHA256 in (badHashes)
    or (FolderPath has "site-packages" and FileName in~ ("cook.pth", "cook.py"))
    or (FolderPath has "site-packages" and FileName =~ "sitecustomize.py" and InitiatingProcessFileName in~ ("pip", "pip3", "pip.exe", "uv", "uv.exe", "python", "python3", "python.exe"))
| project Timestamp, DeviceName, ActionType, FolderPath, FileName, SHA256, InitiatingProcessFileName, InitiatingProcessCommandLine, InitiatingProcessAccountName
| order by Timestamp asc
