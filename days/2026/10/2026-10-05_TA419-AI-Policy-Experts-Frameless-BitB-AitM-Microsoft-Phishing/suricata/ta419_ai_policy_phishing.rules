# Title: TA419 AI-policy phishing campaign - DNS, TLS SNI, certificate and kit-path detections
# Author: Jarmi
# Date: 2026-10-05
# Reference: https://www.proofpoint.com/us/blog/threat-insight/hallucinating-credibility-china-aligned-ta419-impersonates-its-way-us-ai-policy
# Variables: $HOME_NET is your user and server address space; $EXTERNAL_NET is everything else. No custom variable is needed.
# Visibility: DNS rules (6330001, 6330002) need DNS on the wire or a DNS log feed. The SNI rule (6330003) works on TLS 1.2 and 1.3 ClientHello. The certificate subject rule (6330004) needs a TLS 1.2 handshake or a sensor that sees the server certificate. The HTTP rule (6330005) needs decrypted traffic.
# Indicators were first seen between December 2025 and July 2026 and Proofpoint publishes no takedown status; hits show contact with the campaign, not necessarily a live server.
alert dns $HOME_NET any -> any any (msg:"JARMI TA419 DNS query for first-stage or second-stage phishing domain"; dns.query; pcre:"/(?:^|\.)(?:driftshare\.co|quickfly\.online|cirrushare\.co|goshshare\.online|synchvault\.co|msfile\.online|winsync\.cloud|sharehub\.space|globalfileshareplatform\.com|smartsyncbox\.com|mypublicshare\.com|cloudsyncpulse\.com|onecloudfilesync\.com|publicsharefile\.cloud|fileswiftonline\.cloud)$/i"; classtype:trojan-activity; sid:6330001; rev:1; metadata:created_at 2026_10_05, confidence high;)
alert dns $HOME_NET any -> any any (msg:"JARMI TA419 DNS query for lookalike sender domain"; dns.query; pcre:"/(?:^|\.)(?:tw-koryu\.org|heritiages\.org|heritiage\.org|shinjirou\.info)$/i"; classtype:policy-violation; sid:6330002; rev:1; metadata:created_at 2026_10_05, confidence high;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI TA419 TLS SNI for first-stage or second-stage phishing domain"; flow:to_server,established; tls.sni; pcre:"/(?:^|\.)(?:driftshare\.co|quickfly\.online|cirrushare\.co|goshshare\.online|synchvault\.co|msfile\.online|winsync\.cloud|sharehub\.space|globalfileshareplatform\.com|smartsyncbox\.com|mypublicshare\.com|cloudsyncpulse\.com|onecloudfilesync\.com|publicsharefile\.cloud|fileswiftonline\.cloud)$/i"; classtype:trojan-activity; sid:6330003; rev:1; metadata:created_at 2026_10_05, confidence high;)
alert tls any any -> any any (msg:"JARMI TA419 shared self-signed TLS certificate subject Castro Inc Millsstad"; flow:from_server,established; tls.cert_subject; content:"Castro Inc"; content:"Millsstad"; classtype:trojan-activity; sid:6330004; rev:1; metadata:created_at 2026_10_05, confidence medium;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"JARMI TA419 Frameless BitB telemetry module request /secondary/observe.js"; flow:to_server,established; http.method; content:"GET"; http.uri; content:"/secondary/observe.js"; endswith; classtype:trojan-activity; sid:6330005; rev:1; metadata:created_at 2026_10_05, confidence low;)
alert ip $HOME_NET any -> 108.61.163.187 any (msg:"JARMI TA419 connection to the VPS seen in a first-hop Received header (single observation, verify before blocking)"; classtype:policy-violation; sid:6330006; rev:1; metadata:created_at 2026_10_05, confidence low;)
